{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "flatppl",
      "camelcase": "Flatppl",
      "scope": "source.flatppl",
      "path": ".",
      "file-types": [
        "flatppl"
      ],
      "injection-regex": "^flatppl$",
      "highlights": [
        "queries/highlights.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "FlatPPL grammar for tree-sitter",
    "authors": [
      {
        "name": "flatppl"
      }
    ],
    "links": {
      "repository": "https://github.com/flatppl/flatppl-grammars"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
