{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "flatppl.embedded.python",
  "injectionSelector": "L:source.python -comment",
  "patterns": [
    { "include": "#flatppl-call" }
  ],
  "repository": {
    "flatppl-call": {
      "comment": "Embedded canonical FlatPPL in Python: flatppl(r\"\"\"…\"\"\") / flatppl(r'''…'''). The raw-string prefix (r/R, optionally with b) is optional but recommended; both triple-quote styles are supported.",
      "begin": "(\\bflatppl)\\s*(\\()\\s*((?:[rR][bB]?|[bB][rR])?)(\"\"\"|''')",
      "beginCaptures": {
        "1": { "name": "support.function.flatppl.python" },
        "2": { "name": "punctuation.section.arguments.begin.bracket.round.python" },
        "3": { "name": "storage.type.string.python" },
        "4": { "name": "punctuation.definition.string.begin.python" }
      },
      "end": "(\\4)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.python" }
      },
      "contentName": "meta.embedded.block.flatppl",
      "patterns": [
        { "include": "source.flatppl" }
      ]
    }
  }
}
